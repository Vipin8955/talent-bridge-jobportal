# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set to your MongoDB connection string (e.g., mongodb://localhost:27017/jobportal or Atlas URI)
# If empty or unreachable in development, the server will automatically use mongodb-memory-server
MONGODB_URI=mongodb://127.0.0.1:27017/jobportal

# JWT Configuration
JWT_SECRET=jobportal_super_secret_jwt_key_2026_production_grade
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# File Uploads
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads/resumes
